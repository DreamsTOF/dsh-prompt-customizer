{
  "name": "dsh-prompt-customizer",
  "description": "System-prompt & tool customizer for DeepSeek Harness with a settings-panel UI: block / replace / inject prompt sections by name, and hide tools from the model catalog by exclude/include. Config lives in the plugin's own ~/.dsh/prompt-customizer/config.yaml (auto-migrated once from the legacy settings.yaml section).",
  "version": "0.4.2",
  "type": "module",
  "private": false,
  "main": "lib/index.js",
  "author": "DreamsTOF",
  "license": "MIT",
  "homepage": "https://github.com/DreamsTOF/dsh-prompt-customizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamsTOF/dsh-prompt-customizer.git"
  },
  "bugs": {
    "url": "https://github.com/DreamsTOF/dsh-prompt-customizer/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "system-prompt",
    "prompt-engineering",
    "tool-filter",
    "cordis",
    "plugin",
    "agent"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "build": "tsdown",
    "test": "node --test",
    "check": "npm run typecheck && npm run build && npm run test",
    "prepack": "npm run build"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib",
    "client",
    "src",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  }
}
