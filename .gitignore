# Dependencies
node_modules/

# Sourcemap stays out (large, and it churns on every build). The built client
# bundle itself is committed on purpose: this package is installed as a git
# dependency (`dsh plugin --profile web add github:DreamsTOF/dsh-prompt-customizer`)
# or straight from a fresh clone, and pnpm >= 10 blocks a git dependency's
# `prepare` script until allowlisted under `allowBuilds` — shipping the built
# bundle means source installs work in one shot (a missing bundle silently keeps
# the browser half out of the host boot graph). Rebuild (`npm run build`) before
# committing any client-source change.
*.js.map

# Copied client bundle inside lib (build artifact, not source)
lib/client.js

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.trae/
*.swp

# Env / secrets
.env
.env.*

# npm auth token (local publish credential)
.npmrc