{
  "name": "dsh-prompt-customizer",
  "version": "0.6.0",
  "description": "DeepSeek Harness 的三合一能力台：提示词定制（按名称屏蔽 / 替换 / 注入 / 排序，按会话阶段与 agent 预设分层）+ 技能集合管理（导入 / 分组 / 开关）+ MCP Server 接入（分层遮蔽与工具级启停）。纯插件注入，不动官方源码。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "prompt-engineering",
    "skills",
    "mcp",
    "tool-filter",
    "cordis",
    "plugin",
    "agent"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "author": "DreamsTOF",
  "license": "MIT",
  "homepage": "https://github.com/DreamsTOF/dsh-prompt-customizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamsTOF/dsh-prompt-customizer.git"
  },
  "bugs": {
    "url": "https://github.com/DreamsTOF/dsh-prompt-customizer/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "comment:files": "只发运行时需要的部分：lib / client 是构建产物（vendor 的叶子模块与依赖在构建时已内联），scripts 供已安装位置自检；src / vendor / test 只用于重新构建与开发。",
  "files": [
    "lib",
    "client",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "smoke": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs",
    "check": "npm run build && npm test && npm run smoke",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.6-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
