{
  // Typecheck-only project for the browser client sources (src/client), which
  // tsdown bundles into client/client.js.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/client"]
}
